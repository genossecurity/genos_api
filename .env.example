# Copy this file to .env and fill in values that apply to your deployment.
# The .env file is excluded from version control by .gitignore.

# -------------------------------------------------------------------
# MongoDB — required for the /scan (authenticated) route.
# Leave empty to run in no-DB mode (only /scan/internal will work).
# -------------------------------------------------------------------
MONGO_URI=

# -------------------------------------------------------------------
# Internal route auth — optional.
# When set, /scan/internal requires this token in the request body.
# When unset, /scan/internal is token-free (suitable for local use only).
# -------------------------------------------------------------------
INTERNAL_TEST_TOKEN=

# -------------------------------------------------------------------
# Runtime configuration
# -------------------------------------------------------------------

# Gunicorn bind address.  Change only when running behind a reverse proxy
# that expects a different local port.  Never bind to 0.0.0.0 directly.
GENOS_API_BIND=127.0.0.1:6001

# Tokeniser max sequence length fed to CodeBERT.
# Increasing this above 512 has no effect (model hard limit).
GENOS_MAX_TOKENS=256

# Timestamp written into MongoDB usage records.
# Leave empty to use the hardcoded fallback in app.py.
CURRENT_TIME=

# -------------------------------------------------------------------
# Training-only settings (not used by the API at runtime)
# -------------------------------------------------------------------
GENOS_T1_EFFECTIVE_BATCH=256
GENOS_T1_MICRO_BATCH=32
GENOS_T1_USE_COMPILE=0
